# Spring Boot does not load .env files automatically.
# Copy this file to .env and export the values in your shell before running the app.

PORT=9091
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3306/taxedge_db
DB_USERNAME=root
DB_PASSWORD=root

JWT_SECRET=dev-local-jwt-secret-key-0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ

CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200,http://localhost:3000

COMPANY_REGISTRATION_STORAGE_DIR=./uploads/company-registration
PROPERTY_LOAN_STORAGE_DIR=./uploads/property-loans